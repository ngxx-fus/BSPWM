#!/bin/zsh

# Set environment variables for input method & smooth gestures
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export MOZ_USE_XINPUT2=1
export DOT_CONF="/home/fus/.config"
export DOT_FUS="/home/fus/.fus"

# Start sxhkd hotkey daemon if not running (use /bin/sh to prevent zsh tilde expansion errors)
export SXHKD_SHELL=/bin/sh
pgrep -x sxhkd > /dev/null || sxhkd -c $DOT_CONF/bspwm/sxhkd/sxhkdrc &

# Validate display config only on initial startup ($1 == 0), not on 'bspc wm -r' reload
if [[ "${1:-0}" -eq 0 ]]; then
    $DOT_CONF/bspwm/scripts/Helper-DisplaySwitching --startup
fi

# Automatically remove disabled or unplugged monitors from bspwm
bspc config remove_disabled_monitors  true
bspc config remove_unplugged_monitors true

# Query ONLY active (turned-on) monitors so turned-off panels (e.g. eDP-1 --off) are ignored
MONITORS=($(xrandr --listactivemonitors 2>/dev/null | awk 'NR>1 {print $NF}'))
if (( ${#MONITORS[@]} == 0 )); then
    MONITORS=($(xrandr --query | grep " connected" | cut -d" " -f1))
fi

# Assign independent workspaces 1-9 to each active monitor
for m in "${MONITORS[@]}"; do
    bspc monitor "$m" -d 1 2 3 4 5 6 7 8 9
done

# Remove any inactive monitors still tracked by bspwm
for m in $(bspc query -M --names 2>/dev/null); do
    if (( ${MONITORS[(Ie)$m]} == 0 )); then
        bspc monitor "$m" -r 2>/dev/null
    fi
done

# Padding configuration (fix large top margin under Polybar)
bspc config top_padding          -2
bspc config bottom_padding       0
bspc config left_padding         0
bspc config right_padding        0

# Window layout and gap configurations
bspc config border_width         2
bspc config window_gap           4
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config honor_size_hints     false

# Border color styling
bspc config normal_border_color  "#282828"
bspc config focused_border_color "#50a5f5"

# Window rules
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a mplayer2 state=floating
bspc rule -a Screenkey manage=off

# Window management rules migrated from Openbox
bspc rule -a copyq state=floating rectangle=800x600+0+0 center=on
bspc rule -a Gsimplecal state=floating manage=off
bspc rule -a pavucontrol state=floating rectangle=950x650+0+0 center=on
bspc rule -a Blueman-manager state=floating rectangle=950x650+0+0 center=on
bspc rule -a Nm-connection-editor state=floating rectangle=950x650+0+0 center=on
bspc rule -a "Event Tester" state=floating
bspc rule -a "btop-term" state=floating rectangle=950x650+0+0 center=on
bspc rule -a "wifi-float-term" state=floating rectangle=950x650+0+0 center=on

# Thunar file manager rules
bspc rule -a Code:code:Open* state=floating rectangle=950x650+0+0 center=on
bspc rule -a Code:code:Save* state=floating rectangle=950x650+0+0 center=on

# Launch PipeWire audio stack once (required on Void Linux / runit without systemd user units)
pgrep -x pipewire > /dev/null           || /usr/bin/pipewire &
pgrep -x pipewire-pulse > /dev/null     || /usr/bin/pipewire-pulse &
pgrep -x wireplumber > /dev/null        || /usr/bin/wireplumber &

# Launch core daemons once
pgrep -x lxpolkit > /dev/null           || /usr/bin/lxpolkit &
pgrep -x fcitx5 > /dev/null             || /usr/bin/fcitx5 -d &
pgrep -x dunst > /dev/null              || /usr/bin/dunst -config $DOT_CONF/bspwm/dunst/dunstrc &
pgrep -x picom > /dev/null              || /usr/bin/picom --config $DOT_CONF/bspwm/picom/picom.conf -b &
pgrep -x skippy-xd > /dev/null          || /usr/local/bin/skippy-xd --config $DOT_CONF/bspwm/skippy-xd/skippy-xd.rc --start-daemon &
pgrep -x copyq > /dev/null              || /usr/bin/copyq &
pgrep -u "$USER" -x touchegg >/dev/null || /usr/bin/touchegg >/dev/null 2>&1 &

# Mouse interaction (Super key + Mouse drag)
bspc config pointer_modifier   mod4
bspc config pointer_action1    move
bspc config pointer_action2    resize_side
bspc config pointer_action3    resize_side

# Focus follows pointer (hover focus)
bspc config focus_follows_pointer true

# Allow dragging/moving tiled windows across nodes
bspc config pointer_motion_interval 17

# Wallpaper and status bar
$DOT_CONF/bspwm/scripts/Service-Polybar &
$DOT_CONF/bspwm/scripts/Service-Background &

# Inactivity lock and suspend daemon (Void Linux elogind compatible)
pgrep -x xidlehook > /dev/null || /home/fus/.cargo/bin/xidlehook \
    --not-when-audio \
    --not-when-fullscreen \
    --timer 300 'betterlockscreen -l blur' '' \
    --timer 600 'loginctl suspend' '' &
