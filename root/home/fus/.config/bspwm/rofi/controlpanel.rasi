* {
    bg:               #161616;
    background-color: @bg;
    font:             "JetBrainsMono Nerd Font 12";  /* Monospace font for alignment */
}

configuration {
    show-icons:   true;
    icon-theme:   "Papirus";
    display-drun: "Launch:";
}

window { 
    /* Compact size centered on screen */
    width:            50%;
    transparency:     "real";
    orientation:      vertical;
    border:           2px;
    border-color:     #4fc3f7;
    border-radius:    10px;

    /* Center positioning */
    location:         center;
    anchor:           center;
    x-offset:         0px;
    y-offset:         0px;
}

mainbox {
    children: [inputbar, listview];
}

// ELEMENT
// -----------------------------------

element {
    padding:          6 12;
    text-color:       #F2F4F8;
    background-color: #161616;
    border-radius:    5px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    size:             18px;
    background-color: inherit;
    padding:          0 8 0 0;
    alignment:        vertical;
}

element.normal.normal {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.normal.active {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.normal.urgent {
    background-color: #f25d78;
    text-color:       #161616;
}

element.selected.normal {
    background-color: #CCFBFA;
    text-color:       #161616;
}

element.selected.active {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.alternate.normal {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.alternate.active {
    background-color: #CCFBFA;
    text-color:       #F2F4F8;
}

listview {
    columns:          2;  /* Show in a single column for clean alignment */
    lines:            8;  /* Match total action items in power menu */
    padding:          8 10;
    fixed-height:     true;
    fixed-columns:    true;
    border:           0px;
}

inputbar {
    padding:          8 12;
    margin:           0;
    children:         [prompt, entry];
}

entry {
    text-color:       #dfebff;
    padding:          0 0 0 6;
}

prompt {
    text-color:       #78a9ff;
    padding:          0;
}