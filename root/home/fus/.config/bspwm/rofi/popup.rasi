@import "colors.rasi"

configuration {
    show-icons: false;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    location: northeast;
    anchor: northeast;
    x-offset: -10px;
    y-offset: 38px;

    width: 270px;
    transparency: "real";
    orientation: vertical;
    border: 2px;
    border-color: @accent-2;
    border-radius: 8px;
}

mainbox {
    children: [inputbar, listview];
}


// ELEMENT
// -----------------------------------

element {
    padding:          6 12;
    text-color:       #F2F4F8;
    background-color: #161616;
    border-radius:    5px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    size:             18px;
    background-color: inherit;
    padding:          0 8 0 0;
    alignment:        vertical;
}

element.normal.normal {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.normal.active {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.normal.urgent {
    background-color: #f25d78;
    text-color:       #161616;
}

element.selected.normal {
    background-color: #CCFBFA;
    text-color:       #161616;
}

element.selected.active {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.alternate.normal {
    background-color: #161616;
    text-color:       #F2F4F8;
}

element.alternate.active {
    background-color: #CCFBFA;
    text-color:       #F2F4F8;
}

listview {
    columns:          1;  /* Show in a single column for clean alignment */
    lines:            5;  /* Match total action items in power menu */
    padding:          8 10;
    fixed-height:     true;
    fixed-columns:    true;
    border:           0px;
}

inputbar {
    padding:          8 12;
    margin:           0;
    children:         [prompt, entry];
}

entry {
    text-color:       #f27893;
    padding:          0 0 0 6;
}

prompt {
    text-color:       #78a9ff;
    padding:          0;
}