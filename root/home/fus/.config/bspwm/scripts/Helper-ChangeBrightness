#!/bin/bash

# changebrightness - display brightness control with on-screen notification.
# Uses dunst's `progress_bar = true` rendering via the int:value hint.
#
# Usage: changebrightness {up|down} [step]

BRIGHT_STEP="${2:-5%}"

get_icon() {
    # Pick display brightness icon based on level
    if [ "$1" -le 30 ]; then
        echo "display-brightness-low"
    elif [ "$1" -le 70 ]; then
        echo "display-brightness-medium"
    else
        echo "display-brightness-high"
    fi
}

notify_brightness() {
    local brightness icon
    # Extract current percentage as integer (e.g. 45% -> 45)
    brightness=$(brightnessctl -m | awk -F',' '{print substr($4, 1, length($4)-1)}')
    icon=$(get_icon "$brightness")

    notify-send -a changebrightness -u low \
        -h string:x-canonical-private-synchronous:brightness \
        -h "int:value:$brightness" \
        -i "$icon" \
        -t 1500 \
        "Brightness ${brightness}%"
}

case "$1" in
    up)
        # Increase brightness
        brightnessctl set +"$BRIGHT_STEP" -q
        notify_brightness
        ;;
    down)
        # Decrease brightness (min limit 1% to prevent black screen)
        brightnessctl set "$BRIGHT_STEP"- -n 1 -q
        notify_brightness
        ;;
    *)
        echo "Usage: $0 {up|down} [step]" >&2
        exit 1
        ;;
esac
