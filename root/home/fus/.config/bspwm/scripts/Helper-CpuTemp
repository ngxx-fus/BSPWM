#!/usr/bin/env zsh

# Read CPU stats into arrays (avoids multiple spaces issue in Zsh)
stat1=( $(head -n1 /proc/stat) )
sleep 0.5
stat2=( $(head -n1 /proc/stat) )

# Calculate total and idle times (Zsh arrays are 1-indexed)
total1=$(( stat1[2] + stat1[3] + stat1[4] + stat1[5] + stat1[6] + stat1[7] + stat1[8] + stat1[9] ))
total2=$(( stat2[2] + stat2[3] + stat2[4] + stat2[5] + stat2[6] + stat2[7] + stat2[8] + stat2[9] ))
idle1=$(( stat1[5] + stat1[6] ))
idle2=$(( stat2[5] + stat2[6] ))

diff_total=$(( total2 - total1 ))
diff_idle=$(( idle2 - idle1 ))

if (( diff_total > 0 )); then
    cpu=$(( (diff_total - diff_idle) * 100 / diff_total ))
else
    cpu=0
fi

# Get CPU temp (priority: x86_pkg_temp > TCPU > acpitz)
temp=""
for z in /sys/class/thermal/thermal_zone<->(N); do
    type=$(cat "$z/type" 2>/dev/null)
    if [[ "$type" == "x86_pkg_temp" ]]; then
        temp=$(( $(cat "$z/temp" 2>/dev/null) / 1000 ))
        break
    fi
done

# Fallback to TCPU or acpitz if x86_pkg_temp is not found
if [[ -z "$temp" ]]; then
    for z in /sys/class/thermal/thermal_zone<->(N); do
        type=$(cat "$z/type" 2>/dev/null)
        if [[ "$type" == "TCPU" || "$type" == "acpitz" ]]; then
            temp=$(( $(cat "$z/temp" 2>/dev/null) / 1000 ))
            break
        fi
    done
fi

[[ -z "$temp" ]] && temp="--"

# Choose thermal ramp icon based on temperature
if [[ "$temp" != "--" ]] && (( temp >= 80 )); then
    t_icon="%{F#ebf831}%{F-}"
elif [[ "$temp" != "--" ]] && (( temp >= 65 )); then
    t_icon="%{F#50a5f5}%{F-}"
elif [[ "$temp" != "--" ]] && (( temp >= 50 )); then
    t_icon="%{F#50a5f5}%{F-}"
else
    t_icon="%{F#50a5f5}%{F-}"
fi

printf "%2d%%  %s %s°C\n" "$cpu" "$t_icon" "$temp"