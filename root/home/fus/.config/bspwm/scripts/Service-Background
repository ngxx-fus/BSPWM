#!/bin/zsh

set -e
setopt EXTENDED_GLOB

# CONFIG ######################################################

# Lockfile management to prevent concurrent executions
PID_FILE="/tmp/background_slideshow.pid"

NO_LOCKSCREEN_RENDER=$1

# Terminate existing instance(s) if already running
if [[ -f "$PID_FILE" ]]; then
    old_pid=$(cat "$PID_FILE" 2>/dev/null)
    if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
        echo "[*] Killing previous background process (${old_pid})..."
        pkill -P "$old_pid" 2>/dev/null || true
        kill "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
fi

# Also clean up any leaked/orphaned Service-Background instances whose PID_FILE was lost
for pid in $(pgrep -f "/scripts/Service-Background" 2>/dev/null); do
    if [[ "$pid" != "$$" && "$pid" != "$PPID" ]]; then
        pkill -P "$pid" 2>/dev/null || true
        kill "$pid" 2>/dev/null || true
    fi
done

# Register current process PID
echo "$$" > "$PID_FILE"

SLEEP_PID=""
RENDER_PID=""

cleanup() {
    [[ -n "$SLEEP_PID" ]] && kill "$SLEEP_PID" 2>/dev/null || true
    [[ -n "$RENDER_PID" ]] && kill "$RENDER_PID" 2>/dev/null || true
    pkill -P "$$" 2>/dev/null || true
    if [[ -f "$PID_FILE" ]] && [[ "$(cat "$PID_FILE" 2>/dev/null)" == "$$" ]]; then
        rm -f "$PID_FILE"
    fi
    exit 0
}

# Clean up PID file and child processes on exit or termination signals
trap cleanup INT TERM EXIT

# Interruptible sleep so SIGTERM is handled immediately instead of waiting for sleep to finish
WaitInterval() {
    sleep "$1" &
    SLEEP_PID=$!
    wait "$SLEEP_PID" 2>/dev/null || true
    SLEEP_PID=""
}

DIR_BACKGROUND_IMGS="${HOME}/.config/bspwm/wallpaper/Blao"
FILE_BACKGROUND_IMG="${HOME}/Pictures/Wallpapers/default.png"

# Set 0 if specifying a single image in FILE_BACKGROUND_IMG
CONF_INPUTDIR_EN=1

# Set 1 for random selection, 0 for sequential order
CONF_RANDOM_EN=1

# Delay between wallpaper changes in seconds (e.g., 300 = 5 mins)
CONF_INTERVAL=300

# Match all variations (.jpg, .JPG, .Jpg, .png, .PNG, etc.)
IMG_PATTERNS=('(#i)*.jpg' '(#i)*.jpeg' '(#i)*.png' '(#i)*.webp' '(#i)*.bmp')

# FUNC UTILS ##################################################

##
 # Set desktop wallpaper via feh
 # 
 # @param 1 Target image path
 # @return 0 on success, 1 on failure
 ##
SetWallpaper() {
    local target_img="$1"

    # Verify if target file exists and is readable
    if [[ ! -r "$target_img" ]]; then
        echo "[-] Error: Image not readable: ${target_img}"
        # Exit function with error status
        return 1
    fi

    # 1. Apply wallpaper FIRST while GPU/CPU/X11 are idle (avoid concurrent contention)
    /usr/bin/feh --no-fehbg --bg-fill "$target_img"
    echo "[+] Applied wallpaper: ${target_img}"

    # 2. Check if lockscreen rendering is enabled (defaulting to 0 if unset)
    if [ "${NO_LOCKSCREEN_RENDER:-0}" -ne 1 ]; then
        # Cancel any previous unfinished lockscreen render job
        if [[ -n "$RENDER_PID" ]] && kill -0 "$RENDER_PID" 2>/dev/null; then
            pkill -P "$RENDER_PID" 2>/dev/null || true
            kill "$RENDER_PID" 2>/dev/null || true
        fi

        # Render ONLY 'blur' effect (skipping 5 unused effects), with OpenCL disabled
        # (MAGICK_OCL_DEVICE=OFF prevents Intel iGPU stalls/black flashes in picom/Xorg)
        # and low CPU/IO priority so GUI remains completely smooth.
        (
            MAGICK_OCL_DEVICE=OFF MAGICK_THREAD_LIMIT=2 \
                nice -n 19 /usr/local/bin/betterlockscreen -u "$target_img" --fx blur > /dev/null 2>&1
            echo "[+] Applied blur-lockscreen: ${target_img}"
        ) &
        RENDER_PID=$!
    fi

    # No lock screen render is only able to skip one time
    unset NO_LOCKSCREEN_RENDER

    # Return success
    return 0
}

# MAIN LOGIC ##################################################

# Mode 1: Static single image
if [[ $CONF_INPUTDIR_EN -eq 0 ]]; then
    echo "=========================================================="
    echo " Mode: Static Image"
    echo "=========================================================="

    # Expand tilde if present
    target_file="${FILE_BACKGROUND_IMG/#\~/$HOME}"

    # Apply static wallpaper directly
    SetWallpaper "$target_file"
    [[ -n "$RENDER_PID" ]] && wait "$RENDER_PID" 2>/dev/null || true
    # End execution for static mode
    exit 0
fi

# Mode 2: Directory rotation
target_dir="${DIR_BACKGROUND_IMGS/#\~/$HOME}"

# Validate wallpaper directory
if [[ ! -d "$target_dir" ]]; then
    echo "[-] Error: Wallpaper directory does not exist: ${target_dir}"
    # Stop script due to invalid directory
    exit 1
fi

echo "=========================================================="
echo " Mode: Directory Slideshow (${target_dir})"
echo " Interval: ${CONF_INTERVAL}s | Random: ${CONF_RANDOM_EN}"
echo "=========================================================="

last_selected_img=""

# Infinite loop for background wallpaper switching
while true; do
    # Collect images matching supported extensions inside target directory
    image_list=()
    for ext in "${IMG_PATTERNS[@]}"; do
        # Use zsh globbing with nullglob equivalent (N) to avoid errors if pattern unmatched
        image_list+=(${~target_dir}/${~ext}(N))
    done

    # Check if directory contains valid images
    total_imgs=${#image_list[@]}
    if [[ $total_imgs -eq 0 ]]; then
        echo "[-] Error: No valid images found in ${target_dir}"
        # Terminate loop when no assets are available
        exit 1
    fi

    # Select image based on configuration
    if [[ $CONF_RANDOM_EN -eq 1 ]]; then
        # Pick random index (avoid picking the exact same wallpaper twice in a row when >1 image)
        rand_idx=$(( (RANDOM % total_imgs) + 1 ))
        selected_img="${image_list[$rand_idx]}"
        if (( total_imgs > 1 )) && [[ "$selected_img" == "$last_selected_img" ]]; then
            rand_idx=$(( (rand_idx % total_imgs) + 1 ))
            selected_img="${image_list[$rand_idx]}"
        fi
        last_selected_img="$selected_img"
        SetWallpaper "$selected_img"
    else
        # Loop sequentially through all found images
        for selected_img in "${image_list[@]}"; do
            SetWallpaper "$selected_img"
            WaitInterval "$CONF_INTERVAL"
        done
        # Restart loop after completing sequence
        continue
    fi

    # Wait for the next rotation cycle
    WaitInterval "$CONF_INTERVAL"
done