# Display configuration for Helper-DisplaySwitching
DISP/MODE=2                   # Active mode (0: PC screen only, 1: Duplicate, 2: Extend, 3: Second screen only)
DISP/PROFILE=0                # Active Extend profile index (0, 1, 2, ...)

# Display information
DISP/NUM=4                    # Number of listed displays

DISP/0/Label="eDP-1"          # Built-in display
DISP/0/Width=1920
DISP/0/Height=1200
DISP/0/Refresh=60
DISP/0/Primary=4

DISP/1/Label="DP-1"           # Leave this blank if not used/undetected/unknown
DISP/1/Width=1920
DISP/1/Height=1080
DISP/1/Refresh=60
DISP/1/Primary=3

DISP/2/Label="DP-2"           # Leave this blank if not used/undetected/unknown
DISP/2/Width=1920
DISP/2/Height=1080
DISP/2/Refresh=60
DISP/2/Primary=2

DISP/3/Label="HDMI-1"         # Leave this blank if not used/undetected/unknown
DISP/3/Width=1920
DISP/3/Height=1080
DISP/3/Refresh=60
DISP/3/Primary=1

# Profile information 

PROFILE/0/DESC="Builtin+HDMI"
PROFILE/0/DISP/NUM=2          # Profile 0: For two monitors; HDMI-1/wxh/0x0; eDP-1/wxh/0x1920
PROFILE/0/DISP/0/PosX=0       # Leave this blank if not used/undetected
PROFILE/0/DISP/0/PosY=0       # Leave this blank if not used/undetected
PROFILE/0/DISP/3/PosX=0       # Leave this blank if not used/undetected
PROFILE/0/DISP/3/PosY=1920    # Leave this blank if not used/undetected

PROFILE/1/DESC="DP2+HDMI"
PROFILE/1/DISP/NUM=2          # Profile 1: For two monitors; HDMI-1/wxh/0x0; DP-2/wxh/1080x0
PROFILE/1/DISP/2/PosX=1080    # Leave this blank if not used/undetected
PROFILE/1/DISP/2/PosY=0       # Leave this blank if not used/undetected
PROFILE/1/DISP/3/PosX=0       # Leave this blank if not used/undetected
PROFILE/1/DISP/3/PosY=0       # Leave this blank if not used/undetected

PROFILE/2/DESC="Builtin+DP2+HDMI"
PROFILE/2/DISP/NUM=3          # Profile 2: For three monitors; HDMI-1/wxh/0x0; DP-2/wxh/1080x0; eDP-1/wxh/0x1920
PROFILE/2/DISP/0/PosX=0       # Leave this blank if not used/undetected
PROFILE/2/DISP/0/PosY=0       # Leave this blank if not used/undetected
PROFILE/2/DISP/2/PosX=1080    # Leave this blank if not used/undetected
PROFILE/2/DISP/2/PosY=1920    # Leave this blank if not used/undetected
PROFILE/2/DISP/3/PosX=0       # Leave this blank if not used/undetected
PROFILE/2/DISP/3/PosY=1920    # Leave this blank if not used/undetected

PROFILE/3/DESC="Builtin+DP1+HDMI"
PROFILE/3/DISP/NUM=3          # Profile 3: For three monitors; HDMI-1/wxh/0x0; DP-1/wxh/1080x0; eDP-1/wxh/0x1920
PROFILE/3/DISP/0/PosX=0       # Leave this blank if not used/undetected
PROFILE/3/DISP/0/PosY=0       # Leave this blank if not used/undetected
PROFILE/3/DISP/1/PosX=1080    # Leave this blank if not used/undetected
PROFILE/3/DISP/1/PosY=1920    # Leave this blank if not used/undetected
PROFILE/3/DISP/3/PosX=0       # Leave this blank if not used/undetected
PROFILE/3/DISP/3/PosY=1920    # Leave this blank if not used/undetected
